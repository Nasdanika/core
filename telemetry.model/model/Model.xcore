@xcore.lang.Ecore(nsPrefix="org.nasdanika.telemetry.model", nsURI="ecore://nasdanika.org/core/telemetry/model")
@xcore.lang.GenModel(documentation="An Ecore model of OpenTelemetry concepts - traces, spans, metrics, logs, and supporting types.\nBased on the OpenTelemetry specification: https://opentelemetry.io/docs/specs/otel/",
	modelDirectory="/org.nasdanika.telemetry.model/src/main/java", creationIcons="false",
	editDirectory="/org.nasdanika.telemetry.model.edit/src", modelName="Telemetry",
	editPluginClass="org.nasdanika.telemetry.model.provider.TelemetryEditPlugin",
	editorPluginClass="org.nasdanika.telemetry.model.presentation.TelemetryEditorPlugin",
	testsDirectory="/org.nasdanika.telemetry.model.tests/src",
	testSuiteClass="org.nasdanika.telemetry.model.tests.TelemetryAllTests", importerID="org.eclipse.emf.importer.ecore",
	bundleManifest="false", featureDelegation="Dynamic", containmentProxies="false",
	suppressGenModelAnnotations="false", editorPluginID="org.nasdanika.telemetry.model.editor",
	testsPluginID="org.nasdanika.telemetry.model.tests")
package org.nasdanika.telemetry.model

import org.eclipse.emf.ecore.EByteArray
import org.eclipse.emf.ecore.change.ChangeDescription

@xcore.lang.GenModel(documentation="Resource represents the entity producing telemetry as Attributes.\nFor example, a process producing telemetry that is running in a container on Kubernetes has a Pod name, it is in a namespace and possibly is part of a Deployment which also has a name.\nAll three of these attributes can be included in the Resource.")
class Resource {
	@xcore.lang.GenModel(documentation="Set of attributes that describe the resource.")
	contains KeyValue[] attributes
	@xcore.lang.GenModel(documentation="droppedAttributesCount is the number of dropped attributes. If the value is 0, then no attributes were dropped.")
	int droppedAttributesCount
	@xcore.lang.GenModel(documentation="schema_url contains the URL that describes the semantics of the attributes.")
	String schemaUrl
}

@xcore.lang.GenModel(documentation="InstrumentationScope is a message representing the instrumentation scope information such as the fully qualified name and version.")
class InstrumentationScope {
	@xcore.lang.GenModel(documentation="An empty instrumentation scope name means the name is unknown.")
	String name
	String version
	@xcore.lang.GenModel(documentation="Additional attributes that describe the scope. Use of this parameter is optional.")
	contains KeyValue[] attributes
	int droppedAttributesCount
	@xcore.lang.GenModel(documentation="schema_url contains the URL that describes the semantics of the attributes.")
	String schemaUrl
}

@xcore.lang.GenModel(documentation="KeyValue is a key-value pair that is used to store Span attributes, Link attributes, etc.")
class KeyValue {
	String[1] key
	@xcore.lang.GenModel(documentation="The value associated with the key.")
	contains AnyValue value
}

@xcore.lang.GenModel(documentation="AnyValue is used to represent any type of attribute value. AnyValue may contain a primitive value such as a string or integer or it may contain an arbitrary nested object containing arrays, key-value lists and primitives.")
class AnyValue {
	String stringValue
	Boolean boolValue
	Long intValue
	Double doubleValue
	@xcore.lang.GenModel(documentation="Represents an array of any value.")
	contains AnyValue[] arrayValue
	@xcore.lang.GenModel(documentation="Represents a list of key-value pairs.")
	contains KeyValue[] kvlistValue
	@xcore.lang.GenModel(documentation="Represents raw bytes value.")
	EByteArray bytesValue
}

@xcore.lang.GenModel(documentation="TracesData represents the traces export payload which can be serialized to different formats, e.g., OTLP/gRPC, JSON, and proto.")
class TracesData {
	@xcore.lang.GenModel(documentation="An array of ResourceSpans. For data coming from a single resource this array will typically contain one element. Intermediary nodes that receive data from multiple origins typically batch the data before forwarding further.")
	contains ResourceSpans[] resourceSpans
}

@xcore.lang.GenModel(documentation="A collection of ScopeSpans from a Resource.")
class ResourceSpans {
	@xcore.lang.GenModel(documentation="The resource for the spans in this message. If this field is not set then no resource info is known.")
	contains Resource resource
	@xcore.lang.GenModel(documentation="A list of ScopeSpans that originate from a resource.")
	contains ScopeSpans[] scopeSpans
	@xcore.lang.GenModel(documentation="The URL of the schema that all spans in this message are following.")
	String schemaUrl
}

@xcore.lang.GenModel(documentation="A collection of Spans produced by an InstrumentationScope.")
class ScopeSpans {
	@xcore.lang.GenModel(documentation="The instrumentation scope information for the spans in this message. Semantically when InstrumentationScope isn\'t set, it is equivalent with an empty instrumentation scope name (unknown).")
	contains InstrumentationScope scope
	@xcore.lang.GenModel(documentation="A list of Spans that originate from an instrumentation scope.")
	contains Span[] spans
	String schemaUrl
}

@xcore.lang.GenModel(documentation="A Span represents a single operation performed by a single component of the system.\nThe next available field id is 17.")
class Span {
	@xcore.lang.GenModel(documentation="A unique identifier for a trace. All spans from the same trace share the same trace_id.\nThe ID is a 16-byte array.")
	String traceId
	@xcore.lang.GenModel(documentation="A unique identifier for a span within a trace, assigned when the span is created.\nThe ID is an 8-byte array.")
	String spanId
	@xcore.lang.GenModel(documentation="trace_state conveys information about request position in multiple distributed tracing graphs. It is a vendor-specific format as described by the W3C Trace Context specification.")
	String traceState
	@xcore.lang.GenModel(documentation="The span_id of this span\'s parent span. If this is a root span, then this field must be empty. The ID is an 8-byte array.")
	String parentSpanId
	@xcore.lang.GenModel(documentation="A description of the span\'s operation.\nFor example, the name can be a qualified method name or a file name and a line number where the operation is called. A best practice is to use the same display name at the same call point repeatably, so that users can filter and group spans based on the name.")
	String[1] name
	@xcore.lang.GenModel(documentation="Distinguishes between spans generated in a particular context.")
	SpanKind kind
	@xcore.lang.GenModel(documentation="start_time_unix_nano is the start time of the span. On the client side, this is the time kept by the local machine where the span execution starts. On the server side, this is the time when the server\'s application handler starts running.\nValue is UNIX Epoch time in nanoseconds since 00:00:00 UTC on 1 January 1970.")
	long startTimeUnixNano
	@xcore.lang.GenModel(documentation="end_time_unix_nano is the end time of the span. On the client side, this is the time kept by the local machine where the span execution ends. On the server side, this is the time when the server application handler stops running.\nValue is UNIX Epoch time in nanoseconds since 00:00:00 UTC on 1 January 1970.")
	long endTimeUnixNano
	@xcore.lang.GenModel(documentation="attributes is a collection of key/value pairs. Note, global attributes like server name can be set using the resource API.")
	contains KeyValue[] attributes
	int droppedAttributesCount
	@xcore.lang.GenModel(documentation="events is a collection of Event items.")
	contains SpanEvent[] events
	int droppedEventsCount
	@xcore.lang.GenModel(documentation="links is a collection of Links, which are references from this span to a span in the same or different trace.")
	contains SpanLink[] links
	int droppedLinksCount
	@xcore.lang.GenModel(documentation="An optional final status for this span. Semantically when Status isn\'t set, it means span\'s status code is unset, i.e. assume STATUS_CODE_UNSET (code = 0).")
	contains SpanStatus status
	@xcore.lang.GenModel(documentation="Flags, a bit field. 8 least significant bits are the trace flags as defined in W3C Trace Context specification.")
	int flags
	contains org.eclipse.emf.ecore.change.ChangeDescription changeDescription
	refers LogRecord[] logRecords
}

@xcore.lang.GenModel(documentation="Event is a time-stamped annotation of the span, consisting of user-supplied text description and key-value pairs.")
class SpanEvent {
	@xcore.lang.GenModel(documentation="time_unix_nano is the time the event occurred.")
	long timeUnixNano
	@xcore.lang.GenModel(documentation="name of the event. This field is semantically required to be set to non-empty string by OpenTelemetry API when the event is created explicitly by the instrumentation libraries.")
	String[1] name
	@xcore.lang.GenModel(documentation="attributes is a collection of attribute key/value pairs on the event.")
	contains KeyValue[] attributes
	int droppedAttributesCount
}

@xcore.lang.GenModel(documentation="A pointer from the current span to another span in the same trace or in a different trace. For example, this can be used in batching operations, where a single batch handler processes multiple requests from different traces or when the handler receives a request from a different project.")
class SpanLink {
	@xcore.lang.GenModel(documentation="A unique identifier of a trace that this linked span is part of.")
	String traceId
	@xcore.lang.GenModel(documentation="A unique identifier for the linked span.")
	String spanId
	String traceState
	@xcore.lang.GenModel(documentation="attributes is a collection of attribute key/value pairs on the link.")
	contains KeyValue[] attributes
	int droppedAttributesCount
	@xcore.lang.GenModel(documentation="Flags, a bit field.")
	int flags
}

@xcore.lang.GenModel(documentation="The Status type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs.")
class SpanStatus {
	@xcore.lang.GenModel(documentation="A developer-facing human readable error message.")
	String message
	@xcore.lang.GenModel(documentation="The status code.")
	StatusCode code
}

@xcore.lang.GenModel(documentation="MetricsData represents the metrics export payload which can be serialized to different formats, e.g., OTLP/gRPC, JSON, and proto.")
class MetricsData {
	@xcore.lang.GenModel(documentation="An array of ResourceMetrics.")
	contains ResourceMetrics[] resourceMetrics
}

@xcore.lang.GenModel(documentation="A collection of ScopeMetrics from a Resource.")
class ResourceMetrics {
	contains Resource resource
	contains ScopeMetrics[] scopeMetrics
	String schemaUrl
}

@xcore.lang.GenModel(documentation="A collection of Metrics produced by an Scope.")
class ScopeMetrics {
	contains InstrumentationScope scope
	contains Metric[] metrics
	String schemaUrl
}

@xcore.lang.GenModel(documentation="Defines a Metric which has one or more timeseries. The following is a brief summary of the Metric data model.\n\nMetric is a named entity with a description and unit.")
abstract class Metric {
	@xcore.lang.GenModel(documentation="name of the metric, including its DNS name prefix. It must be unique.")
	String[1] name
	@xcore.lang.GenModel(documentation="description of the metric, which can be used in documentation.")
	String description
	@xcore.lang.GenModel(documentation="unit in which the metric value is reported. Follows the format described by http://unitsofmeasure.org/ucum.html.")
	String unit
	@xcore.lang.GenModel(documentation="Additional metadata attributes that describe the metric.")
	contains KeyValue[] metadata
}

@xcore.lang.GenModel(documentation="Gauge represents the type of a scalar metric that always exports the current value for every data point. It should be used for an unknown aggregation.")
class Gauge extends Metric {
	contains NumberDataPoint[] dataPoints
}

@xcore.lang.GenModel(documentation="Sum represents the type of a scalar metric that is calculated as a sum of all reported measurements over a time interval.")
class Sum extends Metric {
	contains NumberDataPoint[] dataPoints
	AggregationTemporality aggregationTemporality
	@xcore.lang.GenModel(documentation="If true, the sum is monotonically increasing.")
	boolean isMonotonic
}

@xcore.lang.GenModel(documentation="Histogram represents the type of a metric that is calculated by aggregating as a Histogram of all reported measurements over a time interval.")
class Histogram extends Metric {
	contains HistogramDataPoint[] dataPoints
	AggregationTemporality aggregationTemporality
}

@xcore.lang.GenModel(documentation="ExponentialHistogram represents the type of a metric that is calculated by aggregating as a ExponentialHistogram of all reported double measurements over a time interval.")
class ExponentialHistogram extends Metric {
	contains ExponentialHistogramDataPoint[] dataPoints
	AggregationTemporality aggregationTemporality
}

@xcore.lang.GenModel(documentation="Summary metric data are used to convey quantile summaries.")
class Summary extends Metric {
	contains SummaryDataPoint[] dataPoints
}

@xcore.lang.GenModel(documentation="NumberDataPoint is a single data point in a timeseries that describes the time-varying scalar value of a metric.")
class NumberDataPoint {
	contains KeyValue[] attributes
	long startTimeUnixNano
	long timeUnixNano
	@xcore.lang.GenModel(documentation="value as a double. Either asDouble or asInt must be set.")
	Double asDouble
	@xcore.lang.GenModel(documentation="value as an integer. Either asDouble or asInt must be set.")
	Long asInt
	contains Exemplar[] exemplars
	@xcore.lang.GenModel(documentation="Flags is an optional bit field containing hints for the backends.")
	int flags
}

@xcore.lang.GenModel(documentation="HistogramDataPoint is a single data point in a timeseries that describes the time-varying values of a Histogram.")
class HistogramDataPoint {
	contains KeyValue[] attributes
	long startTimeUnixNano
	long timeUnixNano
	@xcore.lang.GenModel(documentation="count is the number of values in the population.")
	long count
	@xcore.lang.GenModel(documentation="sum of the values in the population. If count is zero then this field must be zero.")
	Double sum
	@xcore.lang.GenModel(documentation="bucket_counts is an optional field contains the count values of histogram for each bucket.")
	unique long[] bucketCounts
	@xcore.lang.GenModel(documentation="explicit_bounds specifies buckets with explicitly defined bounds for values.")
	unique double[] explicitBounds
	contains Exemplar[] exemplars
	int flags
	@xcore.lang.GenModel(documentation="min is the minimum value over (start_time, end_time].")
	Double min
	@xcore.lang.GenModel(documentation="max is the maximum value over (start_time, end_time].")
	Double max
}

@xcore.lang.GenModel(documentation="ExponentialHistogramDataPoint is a single data point in a timeseries that describes the time-varying values of a ExponentialHistogram of double values.")
class ExponentialHistogramDataPoint {
	contains KeyValue[] attributes
	long startTimeUnixNano
	long timeUnixNano
	long count
	Double sum
	@xcore.lang.GenModel(documentation="scale describes the resolution of the histogram. Boundaries are located at powers of the base, where base = (2^(2^-scale))")
	int scale
	@xcore.lang.GenModel(documentation="zero_count is the count of values in the zero bucket.")
	long zeroCount
	@xcore.lang.GenModel(documentation="positive carries the positive range of exponential bucket counts.")
	contains ExponentialHistogramDataPointBuckets positive
	@xcore.lang.GenModel(documentation="negative carries the negative range of exponential bucket counts.")
	contains ExponentialHistogramDataPointBuckets negative
	int flags
	contains Exemplar[] exemplars
	Double min
	Double max
	double zeroThreshold
}

@xcore.lang.GenModel(documentation="Buckets are a set of bucket counts, encoded in a contiguous array of counts.")
class ExponentialHistogramDataPointBuckets {
	@xcore.lang.GenModel(documentation="Offset is the bucket index of the first entry in the bucket_counts array.")
	int offset
	unique long[] bucketCounts
}

@xcore.lang.GenModel(documentation="SummaryDataPoint is a single data point in a timeseries that describes the time-varying values of a Summary metric.")
class SummaryDataPoint {
	contains KeyValue[] attributes
	long startTimeUnixNano
	long timeUnixNano
	long count
	double sum
	contains SummaryDataPointValueAtQuantile[] quantileValues
	int flags
}

@xcore.lang.GenModel(documentation="Represents the value at a given quantile of a distribution.")
class SummaryDataPointValueAtQuantile {
	@xcore.lang.GenModel(documentation="The quantile of a distribution. Must be in the interval [0.0, 1.0].")
	double quantile
	@xcore.lang.GenModel(documentation="The value at the given quantile of a distribution.")
	double value
}

@xcore.lang.GenModel(documentation="A representation of an exemplar, which is a sample input measurement. Exemplars also hold information about the environment when the measurement was recorded, for example the span and trace ID of the active span when the exemplar was recorded.")
class Exemplar {
	@xcore.lang.GenModel(documentation="The set of key/value pairs that were filtered out by the aggregator, but recorded alongside the original measurement.")
	contains KeyValue[] filteredAttributes
	long timeUnixNano
	Double asDouble
	Long asInt
	@xcore.lang.GenModel(documentation="(Optional) Span ID of the exemplar trace. span_id may be missing if the measurement is not recorded inside a trace or if the trace is not sampled.")
	String spanId
	@xcore.lang.GenModel(documentation="(Optional) Trace ID of the exemplar trace.")
	String traceId
	refers Span span
}

@xcore.lang.GenModel(documentation="LogsData represents the logs export payload which can be serialized to different formats, e.g., OTLP/gRPC, JSON, and proto.")
class LogsData {
	@xcore.lang.GenModel(documentation="An array of ResourceLogs.")
	contains ResourceLogs[] resourceLogs
}

@xcore.lang.GenModel(documentation="A collection of ScopeLogs from a Resource.")
class ResourceLogs {
	contains Resource resource
	contains ScopeLogs[] scopeLogs
	String schemaUrl
}

@xcore.lang.GenModel(documentation="A collection of Logs produced by a Scope.")
class ScopeLogs {
	contains InstrumentationScope scope
	contains LogRecord[] logRecords
	String schemaUrl
}

@xcore.lang.GenModel(documentation="A log record according to OpenTelemetry Log Data Model: https://opentelemetry.io/docs/specs/otel/logs/data-model/")
class LogRecord {
	@xcore.lang.GenModel(documentation="time_unix_nano is the time when the event occurred. Value is UNIX Epoch time in nanoseconds since 00:00:00 UTC on 1 January 1970.")
	long timeUnixNano
	@xcore.lang.GenModel(documentation="Time when the event was observed by the collection system.")
	long observedTimeUnixNano
	@xcore.lang.GenModel(documentation="Numerical value of the severity, normalized to values described in the log data model.")
	SeverityNumber severityNumber
	@xcore.lang.GenModel(documentation="The severity text (also known as log level). The original string representation as it is known at the source.")
	String severityText
	@xcore.lang.GenModel(documentation="A value containing the body of the log record.")
	contains AnyValue body
	@xcore.lang.GenModel(documentation="Additional attributes that describe the specific event occurrence.")
	contains KeyValue[] attributes
	int droppedAttributesCount
	@xcore.lang.GenModel(documentation="Flags, a bit field.")
	int flags
	@xcore.lang.GenModel(documentation="A unique identifier for a trace. All logs from the same trace share the same trace_id.")
	String traceId
	@xcore.lang.GenModel(documentation="A unique identifier for a span within a trace. If present, this log record is associated with a specific span.")
	String spanId
}

@xcore.lang.GenModel(documentation="SpanKind is the type of span. Can be used to specify additional relationships between spans in addition to a parent/child relationship.")
enum SpanKind {
	@xcore.lang.GenModel(documentation="Unspecified. Do NOT use as default. Implementations MAY assume SpanKind to be INTERNAL when receiving UNSPECIFIED.")
	SPAN_KIND_UNSPECIFIED
	@xcore.lang.GenModel(documentation="Indicates that the span represents an internal operation within an application, as opposed to an operations happening at the boundaries of a process.")
	SPAN_KIND_INTERNAL = 1
	@xcore.lang.GenModel(documentation="Indicates that the span covers server-side handling of an RPC or other remote network request.")
	SPAN_KIND_SERVER = 2
	@xcore.lang.GenModel(documentation="Indicates that the span describes a request to some remote service.")
	SPAN_KIND_CLIENT = 3
	@xcore.lang.GenModel(documentation="Indicates that the span describes a producer sending a message to a broker. Unlike CLIENT and SERVER, there is often no direct critical-path latency relationship between producer and consumer spans.")
	SPAN_KIND_PRODUCER = 4
	@xcore.lang.GenModel(documentation="Indicates that the span describes consumer receiving a message from a broker. Like the PRODUCER kind, there is often no direct critical-path latency relationship between producer and consumer spans.")
	SPAN_KIND_CONSUMER = 5
}

@xcore.lang.GenModel(documentation="For the semantics of status codes see https://github.com/open-telemetry/opentelemetry-specification/blob/main/specification/trace/api.md#set-status")
enum StatusCode {
	@xcore.lang.GenModel(documentation="The default status.")
	STATUS_CODE_UNSET
	@xcore.lang.GenModel(documentation="The Span has been validated by an Application developer or Operator to have completed successfully.")
	STATUS_CODE_OK = 1
	@xcore.lang.GenModel(documentation="The Span contains an error.")
	STATUS_CODE_ERROR = 2
}

@xcore.lang.GenModel(documentation="AggregationTemporality defines how a metric aggregator reports aggregated values. It describes how those values relate to the time interval over which they are aggregated.")
enum AggregationTemporality {
	@xcore.lang.GenModel(documentation="UNSPECIFIED is the default AggregationTemporality, it MUST not be used.")
	AGGREGATION_TEMPORALITY_UNSPECIFIED
	@xcore.lang.GenModel(documentation="DELTA is an AggregationTemporality for a metric aggregator which reports changes since last report time.")
	AGGREGATION_TEMPORALITY_DELTA = 1
	@xcore.lang.GenModel(documentation="CUMULATIVE is an AggregationTemporality for a metric aggregator which reports changes since a fixed start time.")
	AGGREGATION_TEMPORALITY_CUMULATIVE = 2
}

@xcore.lang.GenModel(documentation="Possible values for LogRecord.SeverityNumber.")
enum SeverityNumber {
	@xcore.lang.GenModel(documentation="UNSPECIFIED is the default SeverityNumber, it MUST not be used.")
	SEVERITY_NUMBER_UNSPECIFIED
	SEVERITY_NUMBER_TRACE = 1
	SEVERITY_NUMBER_TRACE2 = 2
	SEVERITY_NUMBER_TRACE3 = 3
	SEVERITY_NUMBER_TRACE4 = 4
	SEVERITY_NUMBER_DEBUG = 5
	SEVERITY_NUMBER_DEBUG2 = 6
	SEVERITY_NUMBER_DEBUG3 = 7
	SEVERITY_NUMBER_DEBUG4 = 8
	SEVERITY_NUMBER_INFO = 9
	SEVERITY_NUMBER_INFO2 = 10
	SEVERITY_NUMBER_INFO3 = 11
	SEVERITY_NUMBER_INFO4 = 12
	SEVERITY_NUMBER_WARN = 13
	SEVERITY_NUMBER_WARN2 = 14
	SEVERITY_NUMBER_WARN3 = 15
	SEVERITY_NUMBER_WARN4 = 16
	SEVERITY_NUMBER_ERROR = 17
	SEVERITY_NUMBER_ERROR2 = 18
	SEVERITY_NUMBER_ERROR3 = 19
	SEVERITY_NUMBER_ERROR4 = 20
	SEVERITY_NUMBER_FATAL = 21
	SEVERITY_NUMBER_FATAL2 = 22
	SEVERITY_NUMBER_FATAL3 = 23
	SEVERITY_NUMBER_FATAL4 = 24
}